# R package build artifacts
*.Rcheck/
*.tar.gz
src/*.o
src/*.so
src/*.dll

# GitLab CI cache (R_LIBS_USER and rcmdcheck output dir)
ci/
check/

# R session files
.Rhistory
.Rproj.user
.RData

# Vignette build artifacts (auto-generated by R CMD build / pkgdown CI;
# already excluded from the user tarball via .Rbuildignore)
inst/doc/
vignettes/*.html
vignettes/*.pdf

# OS files
.DS_Store
Thumbs.db

# Raw data with real coordinates — never commit
data/
data

# Development-only benchmarks and diagnostics
scratch/

# Local Claude Code and user-task files
.claude/
CLAUDE_UserTask.md
resources/

# Publication build artifacts (companion paper/note are now sibling repos,
# not submodules; this catches stray TeX outputs if the package is built
# alongside them in the same workspace)
texput.log
/doc/
/Meta/
docs/

# Sweep artefacts (large/generated/per-machine)
sweep/*/data/
sweep/*/results/
sweep/*/logs/
sweep/*/results.tar.zst
sweep/*/logs.tar.zst
sweep/*/container.sif
sweep/*/grid.csv

# Local archival store (heavy material moved out of active folders)
archive/

# Benchmark run logs (regenerable from the phase scripts)
benchmarks/*/phase*.log

# Numerical-agreement check artefact (regenerated on each run of
# benchmarks/c_port_vs_move/compare.R; the markdown REPORT is the
# tracked record).
benchmarks/c_port_vs_move/compare_stats.rds

# Per-audit raw GPS caches: ship scripts + aggregate results, not the data
audits/*/data/
